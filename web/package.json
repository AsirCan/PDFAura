{
  "name": "pdfaura-web",
  "private": true,
  "version": "0.0.0",
  "description": "PDF Aura's window, drawn by Edge WebView2 (see issue #25). Built into web/dist, which the Python app serves.",
  "type": "module",
  "engines": {
    "node": ">=22"
